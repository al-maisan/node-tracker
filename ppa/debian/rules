#!/usr/bin/make -f
# ppa/build-ppa.sh copies this dir into the source tree, adds install-units.sh
# and node-tracker.sysusers to it and fills in @COMMIT@.

include /usr/share/dpkg/pkg-info.mk

# Offline build with the vendored modules and the distro's Go.
export GOFLAGS := -mod=vendor -trimpath
export GOPROXY := off
export GOTOOLCHAIN := local
export GOCACHE := $(CURDIR)/.gocache
export GOPATH := $(CURDIR)/.gopath
export CGO_ENABLED := 0

# Build time = changelog date, so a rebuild gives the same binary.
BUILD_TIME := $(shell date -u -d @$(SOURCE_DATE_EPOCH) +%Y-%m-%dT%H:%M:%SZ)
LDFLAGS := -X main.version=v$(DEB_VERSION_UPSTREAM) -X main.commit=@COMMIT@ -X main.buildTime=$(BUILD_TIME)
DEST := debian/node-tracker
DOC := $(DEST)/usr/share/doc/node-tracker

%:
	dh $@

override_dh_auto_clean:
	rm -rf bin .gocache .gopath

override_dh_auto_build:
	go build -ldflags '$(LDFLAGS)' -o bin/node-tracker ./cmd/node-tracker

# The integration tests need bitcoind and are not built without their tag.
override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	go test ./...
endif

# dh_installsysusers (dh-sequence-installsysusers) installs
# debian/node-tracker.sysusers and makes the postinst create the user.
override_dh_auto_install:
	install -Dpm 0755 bin/node-tracker $(DEST)/usr/bin/node-tracker
	install -Dpm 0644 -t $(DOC) README.md
	install -Dpm 0644 -t $(DOC)/assets assets/*
	install -Dpm 0644 -t $(DOC)/docs docs/*.md
	install -Dpm 0644 -t $(DOC)/examples examples/config.yaml
	install -Dpm 0644 -t $(DOC)/vendor/go.yaml.in/yaml/v3 vendor/go.yaml.in/yaml/v3/NOTICE
	debian/install-units.sh deploy/systemd $(CURDIR)/$(DEST)/usr/lib/systemd/system $(CURDIR)/$(DEST)/usr/lib/systemd/user

# Ship the units, enable or start none of them.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_dwz:

# Uncompressed, so the README renders with its logo and links.
override_dh_compress:
	dh_compress -X.md -X.svg -X.yaml
